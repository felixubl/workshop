#!/usr/bin/env python3
"""Re-vendor PREPRINT into assets/preprint/.

    tools/sync-preprint [path-to-preprint]      default ../preprint

The sync itself lives in the system, at preprint/tools/sync, because two
consumers holding two byte-identical copies of it was the same drift the script
exists to stop. This is the local door to it, kept because it is the command
this repo's README documents and the one in the fingers.

To update every consumer at once, run `tools/push` in the system instead.
"""
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
src = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else HERE.parent / "preprint"

if not (src / "tools" / "sync").exists():
    print(f"not a PREPRINT checkout: {src}", file=sys.stderr)
    raise SystemExit(1)

raise SystemExit(subprocess.call([sys.executable, str(src / "tools" / "sync"), str(HERE)]))
