#!/usr/bin/env python3
"""Re-copy PREPRINT into assets/preprint/.

    tools/sync-preprint [path-to-preprint]      default ../preprint

The sync itself lives in the system, at preprint/tools/sync, so the two
consumers do not hold two copies of it. This is the local entry point, kept
because it is the command this repo's README documents.

To update every consumer at once, run `tools/push` in the system instead.
"""
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
src = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else HERE.parent / "preprint"

if not (src / "tools" / "sync").exists():
    print(f"not a PREPRINT checkout: {src}", file=sys.stderr)
    raise SystemExit(1)

raise SystemExit(subprocess.call([sys.executable, str(src / "tools" / "sync"), str(HERE)]))
